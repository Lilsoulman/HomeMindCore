{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:51801",
      "http://127.0.0.1:51801"
    ]
  },
  "ConnectionStrings": {
    "HomeMind": "Server=localhost;Database=nexus_mind;User=root;Password=123456;SslMode=None;AllowPublicKeyRetrieval=True;"
  },
  "Auth": {
    "SigningKey": "HomeMind-local-development-signing-key-change-before-production",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "SmartHome": {
    "MockEnabled": false
  },
  "SecretVault": {
    "Enabled": false,
    "Endpoint": "",
    "TokenEnvironmentVariable": "NEXUSMIND_SECRET_VAULT_TOKEN"
  },
  "Mcp": {
    "Clients": {
      "Xhs": {
        "Enabled": true,
        "CommandFileName": "node",
        "Arguments": "D:\\HomeMind\\tools\\xhs-mcp\\xhs-qr-mcp.cjs",
        "WorkingDirectory": "D:\\HomeMind\\tools\\xhs-mcp",
        "TimeoutSeconds": 180
      },
      "Jianying": {
        "Enabled": true,
        "CommandFileName": "uv",
        "Arguments": "run python jianyingdraft/server.py",
        "WorkingDirectory": "D:\\HomeMind\\tools\\jianying-mcp",
        "TimeoutSeconds": 120
      },
      "HomeAssistant": {
        "Mode": "rest_fallback",
        "ServerName": "home-assistant",
        "EventSubscriptionEnabled": false,
        "Enabled": false,
        "Process": {
          "CommandFileName": "",
          "Arguments": "",
          "WorkingDirectory": "",
          "TimeoutSeconds": 30
        }
      }
    }
  },
  "Clipping": {
    "StoragePath": "data/clipping/materials",
    "AllowedRootPath": "",
    "FfprobePath": "ffprobe",
    "Engines": {
      "VideoUse": { "Enabled": false, "CommandFileName": "", "Arguments": "", "WorkingDirectory": "", "TimeoutSeconds": 300, "HealthCheckArguments": "", "Version": "" },
      "Seedance": { "Enabled": false, "CommandFileName": "", "Arguments": "", "WorkingDirectory": "", "TimeoutSeconds": 300, "HealthCheckArguments": "", "Version": "", "ApiKey": "" },
      "HyperFrames": { "Enabled": false, "CommandFileName": "", "Arguments": "", "WorkingDirectory": "", "TimeoutSeconds": 300, "HealthCheckArguments": "", "Version": "" },
      "Remotion": { "Enabled": false, "CommandFileName": "", "Arguments": "", "WorkingDirectory": "", "TimeoutSeconds": 300, "HealthCheckArguments": "", "Version": "" }
    }
  }
}
