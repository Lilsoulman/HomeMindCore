{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:51801",
      "http://127.0.0.1:51801"
    ]
  },
  "ConnectionStrings": {
    "HomeMind": "Server=localhost;Database=nexus_mind;User=root;Password=123456;SslMode=None;"
  },
  "Auth": {
    "SigningKey": "HomeMind-local-development-signing-key-change-before-production",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "SmartHome": {
    "MockEnabled": false
  },
  "SecretVault": {
    "Enabled": false,
    "Endpoint": "",
    "TokenEnvironmentVariable": "NEXUSMIND_SECRET_VAULT_TOKEN"
  }
}
